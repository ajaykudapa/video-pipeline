{
  "title": "Video Pipeline",
  "uid": "video-pipeline",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Queue depth (all queues)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rabbitmq_queue_messages_ready)", "legendFormat": "ready" },
        { "expr": "sum(rabbitmq_queue_messages_unacked)", "legendFormat": "unacked" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Active workers",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [ { "expr": "count(up{job=\"workers\"} == 1)" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Jobs completed",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [ { "expr": "sum(worker_jobs_completed_total)" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Task throughput by type (per min)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (task_type) (rate(worker_tasks_total{outcome=\"success\"}[1m])) * 60", "legendFormat": "{{task_type}}" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Retries and dead letters (per min)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(worker_tasks_total{outcome=\"retried\"}[1m])) * 60", "legendFormat": "retried" },
        { "expr": "sum(rate(worker_tasks_total{outcome=\"dead_lettered\"}[1m])) * 60", "legendFormat": "dead-lettered" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Task duration p95 (s)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, task_type) (rate(worker_task_duration_seconds_bucket[5m])))", "legendFormat": "{{task_type}}" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Uploads (per min)",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(api_uploads_total[1m])) * 60", "legendFormat": "uploads" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
